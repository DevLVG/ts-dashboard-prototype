# Supabase (trio-sporting-pm) — read-only access to P&L views
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# VITE_SUPABASE_ANON_KEY is the *anon* (publishable) key — NOT the service key.
# The service key must never appear in this repo or in any client bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Catalogue CMS — "Sync to Shopify" action (CMS/scripts/catalog_sync_api.py).
# Local dev / same-machine Cockpit: http://localhost:9878 works directly.
# Production (Vercel-hosted Cockpit): needs a public URL for this API — same
# pending "permanent tunnel/domain" item already flagged for the Shopify
# webhook (CMS-Phase2-Implementation.md). Until that lands, Sync to Shopify
# only works when the Cockpit is run locally on the same Mac as the API.
# Token is a shared secret (not a real auth boundary) — see
# CMS/scripts/catalog_sync_api.py header comment.
VITE_CATALOG_SYNC_API_URL=http://localhost:9878
VITE_CATALOG_SYNC_API_TOKEN=<token in ~/.claude/.catalog_sync_api_token>

# Site Copy CMS — "Sync to site" action (CMS/scripts/copy_sync_api.py, cloned
# from the Catalogue's wrapper, own port so the two never collide). Same
# local-only / pending-tunnel caveat as above.
VITE_COPY_SYNC_API_URL=http://localhost:9879
VITE_COPY_SYNC_API_TOKEN=<token in ~/.claude/.copy_sync_api_token>

# Instructors CMS — "Sync to site" action (CMS/scripts/instructors_sync_api.py,
# cloned from copy_sync_api.py, own port so all three never collide). Same
# local-only / pending-tunnel caveat as above. Publishes cal_instructors rows
# (migration 065) into Horse School's "Your instructors" section — only rows
# with is_active=true AND needs_review=false are ever included.
VITE_INSTRUCTORS_SYNC_API_URL=http://localhost:9880
VITE_INSTRUCTORS_SYNC_API_TOKEN=<token in ~/.claude/.instructors_sync_api_token>
